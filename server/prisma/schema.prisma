generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ─────────────────────────────────────────────

enum UserRole {
  driver
  dispatcher
  maintenance_tech
  compliance_officer
  fleet_admin
}

enum InspectionOutcome {
  pass
  minor_defect
  out_of_service
}

// ─── Core Entities ─────────────────────────────────────

model Company {
  id        String   @id @default(uuid())
  name      String
  // Per-company bearer token for the mocked telematics ingestion endpoint
  // (FR-47/48) — a real device/provider integration, not a logged-in user,
  // so it's checked separately from the JWT/AuthPayload system.
  telematicsApiKey String? @unique @map("telematics_api_key")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  drivers          Driver[]
  vehicles         Vehicle[]
  loads            Load[]
  statuses         DispatchStatus[]
  transitions      DispatchTransition[]
  carrierCompanies CarrierCompany[]
  hosRulesets      HosRuleset[]

  @@map("companies")
}

model HosRuleset {
  id                      String   @id @default(uuid())
  companyId               String   @map("company_id")
  name                    String   @default("Federal Property-Carrying Default")
  maxDrivingHoursPerCycle Float    @default(11) @map("max_driving_hours_per_cycle")
  maxOnDutyWindowHours    Float    @default(14) @map("max_on_duty_window_hours")
  // The reset threshold — a contiguous off_duty/sleeper_berth span at least
  // this long clears accumulated driving/on-duty time (FR-40's "qualifying
  // reset period"). Sum-based simplification, not the real wall-clock rule
  // — see hos.ts's docblock for what that means in practice.
  minOffDutyResetHours    Float    @default(10) @map("min_off_duty_reset_hours")
  createdAt               DateTime @default(now())

  company Company  @relation(fields: [companyId], references: [id])
  drivers Driver[]

  @@index([companyId])
  @@map("hos_rulesets")
}

model CarrierCompany {
  id           String   @id @default(uuid())
  companyId    String   @map("company_id")
  name         String
  contactName  String?  @map("contact_name")
  contactEmail String?  @map("contact_email")
  createdAt    DateTime @default(now())

  company  Company   @relation(fields: [companyId], references: [id])
  drivers  Driver[]
  vehicles Vehicle[]

  @@index([companyId])
  @@map("carrier_companies")
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  passwordHash   String   @map("password_hash")
  name           String
  role           UserRole
  // FR-1: a super-user flag layered on top of any role, not a 6th role.
  platformAdmin  Boolean  @default(false) @map("platform_admin")
  // Links a driver-role login to their Driver profile — needed so
  // "sees only own assignments" (FR-1) has something to scope against.
  driverId       String?  @unique @map("driver_id")
  companyId      String   @map("company_id")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company         Company         @relation(fields: [companyId], references: [id])
  driver          Driver?         @relation(fields: [driverId], references: [id])
  createdLoads    Load[]          @relation("LoadCreator")
  auditLogEntries LoadStatusLog[]

  @@index([companyId])
  @@map("users")
}

enum DriverAdminStatus {
  active
  suspended
}

model Driver {
  id                String   @id @default(uuid())
  name              String
  licenseExpiry     DateTime @map("license_expiry")
  licenseClass      String?  @map("license_class")
  endorsements      String[] @default([])
  medicalCertExpiry DateTime @map("medical_cert_expiry")
  homeTerminal      String?  @map("home_terminal")
  hosRulesetId      String?  @map("hos_ruleset_id")
  // "Ineligible" is deliberately NOT a third value here — FR-10 calls it
  // "computed from expiring credentials," i.e. always the live output of
  // checkEligibility(), never a persisted state that could go stale.
  adminStatus       DriverAdminStatus @default(active) @map("admin_status")
  carrierCompanyId  String?  @map("carrier_company_id")
  companyId         String   @map("company_id")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company        Company         @relation(fields: [companyId], references: [id])
  carrierCompany CarrierCompany? @relation(fields: [carrierCompanyId], references: [id])
  hosRuleset     HosRuleset?     @relation(fields: [hosRulesetId], references: [id])
  loads          Load[]
  user           User?
  dutyEntries    DutyStatusEntry[]

  @@index([companyId])
  @@map("drivers")
}

enum VehicleStatus {
  active
  in_maintenance
  out_of_service
  retired
}

model Vehicle {
  id                     String   @id @default(uuid())
  vin                    String   @unique
  unitNumber             String   @map("unit_number")
  make                   String
  model                  String
  year                   Int?
  plate                  String
  fuelType               String?  @map("fuel_type")
  odometer               Int      @default(0)
  engineHours            Float    @default(0) @map("engine_hours")
  registrationExpiry     DateTime? @map("registration_expiry")
  insuranceExpiry        DateTime? @map("insurance_expiry")
  // Gates the extended eligibility check in Phase 2 (FR-22's
  // "Ineligible — Vehicle Out-of-Service" state).
  status                 VehicleStatus @default(active)
  homeTerminal           String?  @map("home_terminal")
  dataSource             String   @default("manual") @map("data_source")
  lastTelematicsUpdateAt DateTime? @map("last_telematics_update_at")
  carrierCompanyId       String?  @map("carrier_company_id")
  companyId              String   @map("company_id")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  company        Company         @relation(fields: [companyId], references: [id])
  carrierCompany CarrierCompany? @relation(fields: [carrierCompanyId], references: [id])
  loads          Load[]

  @@unique([companyId, unitNumber])
  @@index([companyId])
  @@map("vehicles")
}

enum DutyStatusType {
  driving
  on_duty_not_driving
  off_duty
  sleeper_berth
}

model DutyStatusEntry {
  id             String   @id @default(uuid())
  driverId       String   @map("driver_id")
  companyId      String   @map("company_id")
  loadId         String?  @map("load_id")
  dutyStatus     DutyStatusType @map("duty_status")
  startedAt      DateTime @map("started_at")
  endedAt        DateTime? @map("ended_at")
  // FR-40's per-entry override, defaulting to each duty type's own
  // on-duty-ness (driving/on_duty_not_driving count, off_duty/sleeper_berth
  // don't) when null — see computeHosAvailability's docblock.
  onDutyOverride Boolean? @map("on_duty_override")
  source         String   @default("manual")
  createdAt      DateTime @default(now())

  driver Driver @relation(fields: [driverId], references: [id])
  load   Load?  @relation(fields: [loadId], references: [id])

  @@index([driverId, startedAt])
  @@index([companyId])
  @@map("duty_status_entries")
}

// ─── Workflow Engine ───────────────────────────────────

model DispatchStatus {
  id        String   @id @default(uuid())
  name      String
  code      String
  color     String?                                                     // FR-23, hex or named color for status chips
  // Ordering rank (FR-23). advance() requires target.position >= current;
  // revert() requires target.position < current — this is what makes revert
  // structurally backward-only instead of relying on which edges happen to
  // be seeded (FR-31).
  position  Int      @default(0)
  // Replaces the old `code === "created"` check — the load edit-lock (FR-20)
  // and other "is this the starting status" logic reads this instead.
  isDefault                Boolean  @default(false) @map("is_default")
  isDispatchStatus         Boolean  @default(false) @map("is_dispatch_status")          // FR-38 Route auto-advance target; Dispatch Board left column (later phase)
  isInTransitStatus        Boolean  @default(false) @map("is_in_transit_status")        // Dispatch Board right column (later phase)
  isFlaggedStatus          Boolean  @default(false) @map("is_flagged_status")           // FR-36 Maintenance Workbench left column (later phase)
  isInRepairStatus         Boolean  @default(false) @map("is_in_repair_status")         // FR-36 Maintenance Workbench right column (later phase)
  isComplianceReviewQueue  Boolean  @default(false) @map("is_compliance_review_queue")  // FR-23/41 compliance queue (later phase)
  isOutOfServiceEligible   Boolean  @default(false) @map("is_out_of_service_eligible")  // FR-23 (later phase)
  isOutOfServiceDefault    Boolean  @default(false) @map("is_out_of_service_default")   // FR-23 (later phase)
  // Replaces the old `code === "assigned"` check — advance() runs the
  // eligibility gate against this flag instead.
  requiresEligibilityCheck Boolean  @default(false) @map("requires_eligibility_check")
  // Role codes allowed to advance/revert a load OUT of this status.
  // platformAdmin always bypasses this (see workflow.ts).
  roleVisibility           String[] @default([]) @map("role_visibility")
  requiredFields           Json?    @map("required_fields")                            // FR-23, e.g. {"comment":"required"} — not consumed until a later phase
  companyId String   @map("company_id")
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])

  fromTransitions DispatchTransition[] @relation("FromStatus")
  toTransitions   DispatchTransition[] @relation("ToStatus")
  loads           Load[]
  logsFrom        LoadStatusLog[]      @relation("LogFromStatus")
  logsTo          LoadStatusLog[]      @relation("LogToStatus")

  @@unique([code, companyId])
  @@index([companyId])
  @@map("dispatch_statuses")
}

model DispatchTransition {
  id           String @id @default(uuid())
  companyId    String @map("company_id")
  fromStatusId String @map("from_status_id")
  toStatusId   String @map("to_status_id")
  // FR-24/28: which computed inspection outcome should auto-route through
  // this edge. Null for transitions that are only ever manually picked.
  // Not consumed by advance() until a later phase adds Inspection, but the
  // schema (and its uniqueness invariant below) lands now.
  outcomeTrigger  InspectionOutcome? @map("outcome_trigger")
  // FR-24: the single transition advance() falls back to when called with
  // no explicit targetStatusId. At most one true per fromStatusId — see
  // Task 2's partial unique index.
  isDefaultTarget Boolean @default(false) @map("is_default_target")

  company  Company        @relation(fields: [companyId], references: [id])
  fromStatus DispatchStatus @relation("FromStatus", fields: [fromStatusId], references: [id])
  toStatus   DispatchStatus @relation("ToStatus", fields: [toStatusId], references: [id])

  @@unique([companyId, fromStatusId, toStatusId])
  @@index([companyId])
  @@index([fromStatusId])
  @@index([toStatusId])
  @@map("dispatch_transitions")
}

// ─── Dispatch Domain ───────────────────────────────────

model Load {
  id              String   @id @default(uuid())
  reference       String   @unique
  origin          String
  destination     String
  companyId       String   @map("company_id")
  creatorId       String   @map("creator_id")
  driverId        String?  @map("driver_id")
  vehicleId       String?  @map("vehicle_id")
  // Set by assignDriver() on success — advance()'s eligibility gate uses
  // this as the "before" timestamp when recomputing what eligibility
  // looked like at assignment time (FR-35's eligibility before/after).
  driverAssignedAt DateTime? @map("driver_assigned_at")
  currentStatusId String   @map("current_status_id")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company       Company        @relation(fields: [companyId], references: [id])
  creator       User           @relation("LoadCreator", fields: [creatorId], references: [id])
  driver        Driver?        @relation(fields: [driverId], references: [id])
  vehicle       Vehicle?       @relation(fields: [vehicleId], references: [id])
  currentStatus DispatchStatus @relation(fields: [currentStatusId], references: [id])
  statusLogs    LoadStatusLog[]
  dutyEntries   DutyStatusEntry[]

  @@index([companyId])
  @@index([creatorId])
  @@index([driverId])
  @@index([vehicleId])
  @@index([currentStatusId])
  @@map("loads")
}

model LoadStatusLog {
  id           String   @id @default(uuid())
  loadId       String   @map("load_id")
  fromStatusId String   @map("from_status_id")
  toStatusId   String   @map("to_status_id")
  actorId      String   @map("actor_id")
  reverted     Boolean  @default(false)
  batch        Boolean  @default(false)                    // FR-35 field, unused until a bulk-ops phase — kept false always for now
  comment      String?                                     // FR-35, optional actor comment on this transition
  stopCount    Int?     @map("stop_count")                 // FR-35, unused until routes exist — always null for now
  capturedData Json?    @map("captured_data")               // FR-35, versioned snapshot (eligibility/inspection/HOS) — populated starting in a later phase, always null for now
  createdAt    DateTime @default(now())

  load       Load           @relation(fields: [loadId], references: [id])
  fromStatus DispatchStatus @relation("LogFromStatus", fields: [fromStatusId], references: [id])
  toStatus   DispatchStatus @relation("LogToStatus", fields: [toStatusId], references: [id])
  actor      User           @relation(fields: [actorId], references: [id])

  @@index([loadId])
  @@index([fromStatusId])
  @@index([toStatusId])
  @@index([actorId])
  @@map("load_status_logs")
}
