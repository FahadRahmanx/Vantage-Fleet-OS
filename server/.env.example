# Copy to .env and fill in. Never commit the real .env.

# PostgreSQL connection string.
DATABASE_URL="postgresql://user:password@host:5432/postgres"

# Secret used to sign session tokens. Use a long random value per environment.
JWT_SECRET="change-me"

# Port the API listens on. Binds 0.0.0.0 so it is reachable behind a proxy.
PORT=3001

# Browser origins allowed to call this API, comma-separated.
# http://localhost:5173 is always allowed and does not need listing.
# Only needed when the client is served from a different origin than the API.
CORS_ORIGIN=https://vantage-fleet.duckdns.org

# SMTP credentials for sending invitation emails (FR-6). If SMTP_HOST is
# unset, the server falls back to a non-sending "json transport" (logs the
# email instead of sending it) — this is what the automated test scripts
# run against, so real credentials are only needed for actual delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Vantage Fleet OS <no-reply@vantage-fleet.example>"

# Base URL of the deployed client, used to build the invite-accept link.
# http://localhost:5173 is correct for local development.
CLIENT_BASE_URL=http://localhost:5173
